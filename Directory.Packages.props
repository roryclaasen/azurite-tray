    <PackageVersion Include="MSTest" Version="4.3.3" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.91" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="5.0.0" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>
</Project>
